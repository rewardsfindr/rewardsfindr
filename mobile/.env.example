# Firebase Configuration
# Copy this to .env.development and .env.production and fill in your values

# Firebase Web App Config
# Get from: Firebase Console -> Project Settings -> Your apps -> Web app config
EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key_here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=rewardsfindr-dev
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=rewardsfindr-dev.firebaseapp.com
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=rewardsfindr-dev.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google OAuth Client ID (Web Client ID)
# Get from: Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs -> Web client
# This is the same client auto-created by Firebase when you enabled Google Sign-In
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# API Backend URL
EXPO_PUBLIC_API_URL=http://localhost:3001
